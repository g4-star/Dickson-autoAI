from dataclasses import dataclass
import re

from integrator.email_engine.models import NormalizedEmail


@dataclass
class EmailClassification:
    category: str
    needs_reply: bool
    confidence: float
    reason: str


class EmailClassifier:
    """
    Deterministic first-pass email classifier.

    This classifier intentionally favors conservative behavior.
    Uncertain messages should not automatically trigger replies.
    """

    JOB_KEYWORDS = (
        "job",
        "application",
        "applicant",
        "recruiter",
        "recruitment",
        "interview",
        "hiring",
        "vacancy",
        "vacancies",
        "position",
        "opportunity",
        "career",
        "shortlisted",
        "shortlist",
        "offer",
        "employment",
    )

    SCHOOL_KEYWORDS = (
        "assignment",
        "class",
        "lecture",
        "course",
        "student",
        "school",
        "college",
        "university",
        "exam",
        "test",
        "deadline",
        "tutor",
        "trainer",
        "tm ",
        "training",
    )

    CLIENT_KEYWORDS = (
        "project",
        "website",
        "development",
        "developer",
        "quote",
        "quotation",
        "client",
        "freelance",
        "freelancer",
        "proposal",
        "invoice",
        "payment",
        "business website",
    )

    SERVICE_KEYWORDS = (
        "password",
        "security alert",
        "verification code",
        "verify your",
        "account alert",
        "login",
        "sign in",
        "receipt",
        "transaction",
        "notification",
        "unsubscribe",
        "confirm your account",
        "account activity",
    )

    NEWSLETTER_KEYWORDS = (
        "newsletter",
        "weekly digest",
        "daily digest",
        "unsubscribe",
        "marketing",
        "promotion",
        "promotional",
        "special offer",
    )

    SPAM_KEYWORDS = (
        "you won",
        "winner",
        "lottery",
        "claim your prize",
        "free money",
        "million dollars",
        "urgent transfer",
        "send money",
        "crypto investment",
    )

    def classify(
        self,
        message: NormalizedEmail,
    ) -> EmailClassification:
        text = self._combined_text(message)

        if self._contains(text, self.SPAM_KEYWORDS):
            return EmailClassification(
                category="spam/irrelevant",
                needs_reply=False,
                confidence=0.95,
                reason="Detected strong spam or scam indicators.",
            )

        if self._contains(text, self.JOB_KEYWORDS):
            return EmailClassification(
                category="job/recruiter",
                needs_reply=True,
                confidence=0.90,
                reason="Detected employment or recruitment-related terms.",
            )

        if self._contains(text, self.SCHOOL_KEYWORDS):
            return EmailClassification(
                category="school/class",
                needs_reply=True,
                confidence=0.85,
                reason="Detected education or class-related terms.",
            )

        if self._contains(text, self.CLIENT_KEYWORDS):
            return EmailClassification(
                category="client",
                needs_reply=True,
                confidence=0.85,
                reason="Detected client or project-related terms.",
            )

        if self._contains(text, self.NEWSLETTER_KEYWORDS):
            return EmailClassification(
                category="newsletter",
                needs_reply=False,
                confidence=0.90,
                reason="Detected newsletter or marketing indicators.",
            )

        if self._contains(text, self.SERVICE_KEYWORDS):
            return EmailClassification(
                category="service/notification",
                needs_reply=False,
                confidence=0.85,
                reason="Detected automated service or account notification.",
            )

        return EmailClassification(
            category="personal/professional",
            needs_reply=False,
            confidence=0.40,
            reason="No strong category indicators detected.",
        )

    @staticmethod
    def _combined_text(message: NormalizedEmail) -> str:
        return " ".join(
            [
                message.sender or "",
                message.subject or "",
                message.body or "",
            ]
        ).lower()

    @staticmethod
    def _contains(
        text: str,
        keywords: tuple[str, ...],
    ) -> bool:
        for keyword in keywords:
            pattern = r"\b" + re.escape(keyword.strip()) + r"\b"

            if re.search(pattern, text, re.IGNORECASE):
                return True

        return False
